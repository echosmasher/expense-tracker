# PostgreSQL
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=change_me_in_production

# Derived from above — used by backend
DATABASE_URL=postgres://expense_user:change_me_in_production@localhost:5432/expense_tracker

# MinIO (self-hosted S3-compatible storage) — internal only, never published
# on the host. Images reach the browser through authenticated API routes.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=receipts

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_in_production

# OpenAI API (receipt parsing)
OPENAI_API_KEY=sk-...

# Resend (transactional email)
RESEND_API_KEY=re_...

# Email — sender address
EMAIL_FROM=noreply@yourdomain.com

# Backend port
PORT=3001

# Public port the web app is served on (host side, mapped to nginx :80 in the container)
WEB_PORT=80

# Public URL the app is reached at (used in invite emails, password resets, etc.)
# Production: the public https hostname the Cloudflare Tunnel routes to, e.g.
# https://tracker.yourdomain.no
APP_URL=http://localhost

# Allowed origin for CORS — must match the URL the browser loads the app from.
# Same-origin (nginx-proxied) deploys: set to APP_URL.
WEB_ORIGIN=http://localhost

# Cloudflare Tunnel token (Zero Trust dashboard → Networks → Tunnels → your
# tunnel → Install connector → copy the token from the `cloudflared tunnel run
# --token <...>` command). Routes the public hostname to the `web` service;
# nothing else is exposed to the internet.
TUNNEL_TOKEN=
