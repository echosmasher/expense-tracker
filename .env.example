# PostgreSQL
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=change_me_in_production

# Derived from above — used by backend
DATABASE_URL=postgres://expense_user:change_me_in_production@localhost:5432/expense_tracker

# MinIO (self-hosted S3-compatible storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=receipts

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production

# OpenAI API (receipt parsing)
OPENAI_API_KEY=sk-...

# Resend (transactional email)
RESEND_API_KEY=re_...

# Email — sender address
EMAIL_FROM=noreply@yourdomain.com

# Backend port
PORT=3001
